{
  "manifest_version": 3,
  "name": "Font Inspect",
  "version": "0.1.0",
  "description": "Cliquez sur un texte pour inspecter sa police : famille, taille, graisse, interlignage, interlettrage.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Font Inspect — activer l'inspection",
    "default_icon": "icons/icon.svg"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Activer / désactiver l'inspection de police"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-font-inspect@mzellelilas",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
